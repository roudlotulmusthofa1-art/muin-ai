# ==========================================
# MUIN AI - BACKEND ENVIRONMENT CONFIGURATION
# ==========================================
# Salin file ini menjadi .env:
# cp .env.example .env
# Jangan pernah commit file .env ke Git!

# App Environment
APP_NAME="Muin AI - Fikih & Tafsir Engine"
APP_ENV=development
APP_DEBUG=true
APP_PORT=8001
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 9Router AI Gateway Configuration
# 9Router menyediakan endpoint kompatibel OpenAI untuk multi-provider fallback
NINE_ROUTER_BASE_URL=http://localhost:20129/v1
NINE_ROUTER_API_KEY=your-9router-api-key-here
NINE_ROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
NINE_ROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# LLM Providers Direct (Opsional, jika tidak melalui 9Router langsung)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=muin_turats_chunks

# Embeddings Configuration
# Menggunakan text-embedding-3-small atau bge-m3 untuk teks multibahasa & Arab
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Storage Paths
PDF_STORAGE_DIR=storage/pdfs
EXTRACTED_STORAGE_DIR=storage/extracted
